{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-control.invalid/schemas/factory-frame-v1",
  "title": "Agent Control renderer-independent Factory replacement frame",
  "type": "object",
  "required": ["schema", "id", "sequence", "epoch", "at", "projection"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "agent-control.factory-frame/v1"},
    "id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 1},
    "epoch": {"type": "string"},
    "at": {"type": "string"},
    "projection": {
      "type": "object",
      "required": ["schema", "observedAt", "authority", "entities", "relations", "events", "coverage"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "agent-control.factory/v1"},
        "domain": {"enum": ["FACTORY", "ESTATE"]},
        "estate": {"type": "object"},
        "observedAt": {"type": "string"},
        "authority": {"const": "READ_ONLY_RUNTIME_PROJECTION"},
        "entities": {"type": "array", "maxItems": 600, "items": {"$ref": "#/$defs/entity"}},
        "relations": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/relation"}},
        "events": {"type": "array", "maxItems": 100, "items": {"$ref": "#/$defs/event"}},
        "coverage": {"type": "object", "required": ["omittedEntities", "limits", "limitations"], "properties": {"omittedEntities": {"type": "integer", "minimum": 0}, "limits": {"type": "object"}, "limitations": {"type": "array", "items": {"type": "string"}}}}
      }
    }
  },
  "$defs": {
    "metric": {"type": "object", "required": ["value", "unit", "authority"], "additionalProperties": false, "properties": {"value": {"type": ["number", "null"], "minimum": 0}, "unit": {"type": "string"}, "authority": {"type": "string"}}},
    "entity": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "sourceId", "kind", "label", "state", "laneId", "runId", "workerId", "modelId", "providerId", "at", "metrics", "detail", "links"],
      "properties": {
        "id": {"type": "string"}, "sourceId": {"type": "string"},
        "kind": {"enum": ["job", "planned-work", "lane", "worker", "model", "tool", "baton", "cache", "skill", "evidence", "containment", "host", "cpu", "gpu", "runtime", "endpoint", "service", "storage", "repository", "capability", "unknown"]},
        "label": {"type": "string"}, "state": {"type": "string"}, "laneId": {"type": ["string", "null"]},
        "runId": {"type": ["string", "null"]}, "workerId": {"type": ["string", "null"]}, "modelId": {"type": ["string", "null"]}, "providerId": {"type": ["string", "null"]}, "at": {"type": ["string", "null"]},
        "metrics": {"type": "object", "additionalProperties": {"$ref": "#/$defs/metric"}}, "detail": {"type": "object"},
        "links": {"type": "array", "items": {"type": "object", "required": ["kind", "id", "label"], "additionalProperties": false, "properties": {"kind": {"enum": ["run", "artifact", "board", "lane", "models", "usage", "specialists", "activity"]}, "id": {"type": "string"}, "label": {"type": "string"}}}}
      }
    },
    "relation": {"type": "object", "required": ["id", "from", "to", "kind", "sourceId"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}, "kind": {"enum": ["assignment", "route", "handoff", "evidence", "cache", "skill"]}, "sourceId": {"type": "string"}, "state": {"type": "string"}, "basis": {"type": "string"}, "layer": {"type": "string"}, "label": {"type": "string"}}},
    "event": {"type": "object", "required": ["id", "at", "kind", "entityId", "caption", "sourceId"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "at": {"type": "string"}, "kind": {"type": "string"}, "entityId": {"type": ["string", "null"]}, "caption": {"type": "string"}, "sourceId": {"type": "string"}}}
  }
}
